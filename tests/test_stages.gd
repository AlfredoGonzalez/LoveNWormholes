extends TestCase
## data/stages.json (generated by tools/gen_stages.py): structure, formulas and a stage 1 regression.

const SQUAD := ["p1_club_worm", "p1_slinger_worm", "p1_dino_rider_worm"]


func test_stage_lookup() -> void:
	var all := DataDB.stages_of_era(1)
	assert_eq(all.size(), 10)
	for i in all.size():
		assert_eq(int(all[i]["index"]), i + 1, "ordered by index")
		assert_eq(DataDB.stage(1, i + 1)["id"], all[i]["id"])
	assert_true(DataDB.stage(1, 11).is_empty())
	assert_true(DataDB.stage(9, 1).is_empty())


func test_stages_are_valid() -> void:
	for st in DataDB.stages_of_era(1):
		var n := DataDB.stage_number(int(st["era"]), int(st["index"]))
		var label := "stage %d" % n
		assert_true(not st.has("placeholder"), label + " is no placeholder")
		assert_near(float(st["enemy_base_hp"]), DataDB.enemy_base_hp(n), 0.01, label + " base HP formula")
		assert_true(float(st["food_budget"]) > 0.0, label + " food budget")
		var waves: Array = st["waves"]
		assert_true(waves.size() > 0, label + " has waves")
		var last_t := -1.0
		var has_boss := false
		var spent := 0.0
		for w in waves:
			var t := float(w["t"])
			assert_true(t >= last_t, label + " waves sorted by t")
			last_t = t
			if w.has("boss"):
				has_boss = true
				assert_true(not DataDB.boss(str(w["boss"])).is_empty(), label + " boss exists")
			else:
				var e := DataDB.enemy(str(w["enemy"]))
				assert_true(not e.is_empty(), label + " enemy exists: " + str(w["enemy"]))
				assert_true(int(w["count"]) >= 1 and float(w["interval"]) > 0.0, label + " count/interval")
				spent += float(DataDB.enemy_stats(str(w["enemy"]), 1, int(st["index"]))["cost"]) * int(w["count"])
		assert_eq(has_boss, DataDB.is_boss_stage(n), label + " boss only on stage 10")
		if not has_boss:
			assert_near(float(st["food_budget"]), spent, 1.0, label + " food_budget = sum of enemy costs")
		assert_eq(bool((st["rewards"] as Dictionary)["boss"]), has_boss)
		assert_eq(int((st["rewards"] as Dictionary)["coins"]), DataDB.win_coins(n))


func test_roles_are_mixed_and_countered() -> void:
	# From stage 3 on every stage has all three roles; stage 3+ always carries a counter to Fighters (a heavy).
	for st in DataDB.stages_of_era(1):
		var idx := int(st["index"])
		if idx < 3 or idx == 10:
			continue
		var roles := {}
		for w in st["waves"]:
			roles[str(DataDB.enemy(str(w["enemy"]))["role"])] = true
		assert_true(roles.has("heavy") and roles.has("shooter") and roles.has("fighter"), "stage %d role mix" % idx)


func test_stage_setup_builds_and_runs() -> void:
	for st in DataDB.stages_of_era(1):
		var setup := BattleSetup.make(st, {"squad": SQUAD})
		assert_true((setup["spawns"] as Array).size() > 0, "spawns for stage %d" % int(st["index"]))
		for sp in setup["spawns"]:
			assert_true((setup["enemy_units"] as Dictionary).has(sp["id"]))
	var boss_stage := DataDB.stage(1, 10)
	var setup2 := BattleSetup.make(boss_stage, {"squad": SQUAD})
	assert_true((setup2["boss_defs"] as Dictionary).has("b1_rexy"))


## Plays stage 1 with a trivial scripted player (spawn whatever is ready, cheapest card first) at the
## 'normal' profile for stage 1 (level 1, base levels 1). It must win inside 3 minutes of sim time.
func test_stage1_is_winnable_by_simple_player() -> void:
	var setup := BattleSetup.make(DataDB.stage(1, 1), {
		"squad": SQUAD, "unit_levels": {}, "burrow_level": 1, "base_level": 1, "powers": []})
	var sim := BattleSim.new(setup)
	while sim.result == "" and sim.time < 180.0:
		# Fighter first, then shooter, then heavy; one decision per half second like a casual tapper.
		if sim.tick_count % 15 == 0:
			for i in 3:
				if sim.spawn_player(i):
					break
		sim.tick()
	assert_eq(sim.result, "win", "stage 1 won within 180s, got '%s' at %.0fs" % [sim.result, sim.time])
	assert_true(sim.player_base_hp > sim.player_base_max * 0.5, "base mostly intact")


# ---------------------------------------------------------------- Era 2 (Ancient Egypt)

const SQUAD2 := ["p1_club_worm", "p2_bow_worm", "p2_shield_bearer_worm", "p2_cobra_charmer_worm"]


func test_era2_stages_are_valid() -> void:
	var all := DataDB.stages_of_era(2)
	assert_eq(all.size(), 10)
	for i in all.size():
		var st: Dictionary = all[i]
		assert_eq(int(st["index"]), i + 1)
		assert_eq(str(st["id"]), "2-%d" % (i + 1))
		var n := DataDB.stage_number(2, i + 1)
		var label := "stage 2-%d" % (i + 1)
		assert_near(float(st["enemy_base_hp"]), DataDB.enemy_base_hp(n), 0.01, label + " base HP uses the global n")
		assert_eq(int((st["rewards"] as Dictionary)["coins"]), DataDB.win_coins(n))
		var has_boss := false
		var spent := 0.0
		var last_t := -1.0
		for w in st["waves"]:
			assert_true(float(w["t"]) >= last_t, label + " waves sorted")
			last_t = float(w["t"])
			if w.has("boss"):
				has_boss = true
				assert_eq(str(w["boss"]), "b2_pharaoh_scarab")
			else:
				var e := DataDB.enemy(str(w["enemy"]))
				assert_true(not e.is_empty() and int(e["era"]) == 2, label + " era 2 enemy " + str(w["enemy"]))
				spent += float(DataDB.enemy_stats(str(w["enemy"]), 2, i + 1)["cost"]) * int(w["count"])
		assert_eq(has_boss, i == 9, label + " boss only at stage 10")
		assert_eq(bool((st["rewards"] as Dictionary)["boss"]), i == 9)
		if not has_boss:
			assert_near(float(st["food_budget"]), spent, 1.0, label + " food_budget = sum of costs")


func test_era2_boss_stage_has_pharaoh_and_escorts() -> void:
	var st := DataDB.stage(2, 10)
	var boss_def := DataDB.boss("b2_pharaoh_scarab")
	assert_true(not boss_def.is_empty())
	assert_true((boss_def["escorts"] as Array).size() > 0)
	var setup := BattleSetup.make(st, {"squad": SQUAD2})
	var ids := {}
	for sp in setup["spawns"]:
		ids[sp["id"]] = true
	assert_true(ids.has("b2_pharaoh_scarab"), "boss is spawned")
	assert_true(ids.has("e2_scarab_soldier") and ids.has("e2_locust_archer"), "escorts are spawned")


func test_era2_sand_patches_from_stage_3() -> void:
	for st in DataDB.stages_of_era(2):
		var idx := int(st["index"])
		var rule: Dictionary = st["rule"]
		if idx < 3:
			assert_eq(str(rule["type"]), "none", "no rule in stage %d" % idx)
			continue
		assert_eq(str(rule["type"]), "sand_patch", "sand patches in stage %d" % idx)
		var patches: Array = rule["patches"]
		assert_true(patches.size() >= 1, "patches in stage %d" % idx)
		for p in patches:
			assert_true(float(p["x"]) >= 0.0 and float(p["w"]) > 0.0 and float(p["x"]) + float(p["w"]) <= 1000.0, "patch inside the lane")
	for st in DataDB.stages_of_era(1):
		assert_eq(str((st["rule"] as Dictionary)["type"]), "none", "Era 1 has no rule")


func test_era2_setup_uses_time_sync_and_runs() -> void:
	var st := DataDB.stage(2, 3)
	var setup := BattleSetup.make(st, {"squad": ["p1_club_worm", "p2_bow_worm"]})
	var club: Dictionary = setup["squad"][0]
	assert_near(float(club["hp"]), float(DataDB.unit_stats("p1_club_worm", 1, 2)["hp"]), 0.001)
	assert_true(float(club["hp"]) > float(DataDB.unit_stats("p1_club_worm", 1, 1)["hp"]), "time sync makes Era 1 units stronger")
	var sim := BattleSim.new(setup)
	sim.run(20.0)
	assert_true(sim.units.size() > 0, "enemies arrive")
